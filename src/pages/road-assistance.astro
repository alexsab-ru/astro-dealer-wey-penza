---
import Layout from '@/layouts/Layout.astro';
import settings from '@/data/settings.json';
import Banner from '@/components/Banner/Banner.astro';
import AdvantagesItem from '@/components/Advantages/Item.astro';
import AdvantagesList from '@/components/Advantages/List.astro';
import { Icon } from 'astro-icon/components';
const { brand, legal_city_where } = settings;
const banner = {
	"show": true,
	"type": "",
	"view": "link",
	"imageUrl": "https://cdn.alexsab.ru/pages/wey/road-assistance/banner_desktop.webp",
	"mobileImageUrl": "https://cdn.alexsab.ru/pages/wey/road-assistance/banner_mobile.webp",
	"title": "<nav class=\"mb-5 sm:mb-10\"><ol class=\"flex items-center flex-nowrap whitespace-nowrap gap-1 font-normal text-base\"><li class=\"!m-0 flex items-center flex-nowrap gap-1\"><a href=\"/\" class=\"!text-xs sm:!text-sm !m-0 !leading-none !no-underline font-semibold hover:opacity-80 !text-white\">Главная</a><span class=\"text-xs !leading-none\">&gt;</span></li><li class=\"!m-0 flex items-center flex-nowrap gap-1 truncate\"><span class=\"text-xs sm:text-sm !leading-none opacity-80 truncate\">Помощь на дороге</span></li></ol></nav><h1>Сервис помощи на дороге</h1><div class=\"mt-5\"><a href=\"tel:+78005550350\" class=\"underline text-xl sm:text-3xl\">8 800 555-03-50</a></div>",
	"descr": "Служба информационного центра WEY <br/>работает круглосуточно. <br/>Звонок бесплатный"
};
const advantages = [ 
    {iconName: 'mdi:numeric-1-circle-outline', iconColor: 'text-accent-500', title: 'Консультация по телефону', text: 'Вы можете обратитьсяв информационный центр WEY для получения информационной и технической поддержки по телефону. Специалисты центра WEY осуществляют телефонный инструктаж по ремонту автомобиля. В случае, если ремонт по телефону не привел к положительному результату, организуется выезд экипажа техпомощи на место события для устранения неисправности или транспортировки Вашего автомобиля для последующего ремонта.'},
    {iconName: 'mdi:numeric-2-circle-outline', iconColor: 'text-accent-500', title: 'Техническая помощь', text: 'В случае, если техническая консультация не помогла, организуется выезд специалиста в радиусе 500 км от административных границ города с целью устранения причины обездвижения автомобиля.'},
    {iconName: 'mdi:numeric-3-circle-outline', iconColor: 'text-accent-500', title: 'Эвакуация автомобиля', text: 'Если неисправность не может быть устранена на месте и автомобиль не может начать движение и продолжить его самостоятельно, в том числе по причине ДТП, будет организована эвакуация автомобиля в радиусе 500 км от административных границ города до ближайшего официального дилерского центра.'},
    {iconName: 'mdi:numeric-4-circle-outline', iconColor: 'text-accent-500', title: 'Внедорожная эвакуация', text: 'Если невозможно осуществить ремонт на месте, и автомобиль не может начать движение или продолжить его самостоятельно, в том числе по причине ДТП, при этом транспортное средство оказывается в труднодоступном месте, удаленном от дорог с твердым покрытием не более чем на 50 метров, организуется внедорожная эвакуация автомобиля до ближайшего дилерского центра.'},
    {iconName: 'mdi:numeric-5-circle-outline', iconColor: 'text-accent-500', title: 'Сложная погрузка', text: 'Если невозможно осуществить ремонт на месте, и автомобиль не может начать движение или продолжить его самостоятельно, в том числе по причине ДТП, при этом транспортное средство находится в таком положении или состоянии, что стандартные методы погрузки применить невозможно, организуется погрузка с дальнейшей эвакуацией автомобиля до ближайшего дилерского центра.'},
    {iconName: 'mdi:numeric-6-circle-outline', iconColor: 'text-accent-500', title: 'Транспортировка клиента и пассажира', text: 'В случае эвакуации автомобиля в радиусе 500 км от административных границ города, в котором расположен дилерский центр WEY, водителю и пассажирам будет организована транспортировка до дилерского центра или ближайшего места назначения.'},
    {iconName: 'mdi:numeric-7-circle-outline', iconColor: 'text-accent-500', title: 'Организация проживания в гостиннице клиента и пассажиров', text: 'В случае, если автомобиль был эвакуирован в рамках программы (кроме случаев ДТП) более чем за 500 км от места Вашего проживания или пункта назначения и ремонт невоможно осуществить в течение дня, при необходимости организуется проживание в гостинице уровня 3 (три) звезды на срок не более 3 (трех) ночей, либо до окончания ремонта в зависимости от того, что наступит ранее.'},
    {iconName: 'mdi:numeric-8-circle-outline', iconColor: 'text-accent-500', title: 'Продолжение путешествия клиента и пассажиров', text: 'В случае, если в результате наступления события (кроме случаев ДТП) более чем за 500 км от места Вашего проживания или пункта назначения автомобиль был эвакуирован и ремонт невозможно осуществить в течение 3 (трех) дней, при необходимости возможна компенсация стоимости авиабилетов или ж/д билетов (эконом класса) до места проживания или пункта назначения.'},
];
const advantages2 = [
	{title: '<span class="text-accent-500 text-5xl block mb-4">5 лет</span>Срок действия', text: 'Срок действия программы «Помощь на дороге» составляет 5 лет с даты продажи автомобиля первому покупателю'},
	{title: '<span class="text-accent-500 text-5xl block mb-4">500 км</span>Радиус действия', text: 'от административных границ города до ближайшего официального дилерского центра'},
];
const advantages3 = [
	{iconName: 'file', iconColor: 'text-accent-500', iconClass: 'text-4xl lg:text-6xl mb-3 lg:mb-6 pt-3 lg:pt-6 flex-shrink-0', title: '<a href="https://cdn.alexsab.ru/manuals/wey/manual-wey-05.pdf" target="_blank" class="inline-block pt-3 lg:pt-6">Руководство по эксплуатации WEY 05</a>'},
	{iconName: 'file', iconColor: 'text-accent-500', iconClass: 'text-4xl lg:text-6xl mb-3 lg:mb-6 pt-3 lg:pt-6 flex-shrink-0', title: '<a href="https://cdn.alexsab.ru/manuals/wey/roadside_assistance.pdf" target="_blank" class="inline-block pt-3 lg:pt-6">Cервис помощи на дорогах для владельцев кроссоверов WEY</a>'},
	{iconName: 'file', iconColor: 'text-accent-500', iconClass: 'text-4xl lg:text-6xl mb-3 lg:mb-6 pt-3 lg:pt-6 flex-shrink-0', title: '<a href="https://cdn.alexsab.ru/manuals/wey/manual-WEY-07-RUS.pdf" target="_blank" class="inline-block pt-3 lg:pt-6">Руководство по эксплуатации WEY 07</a>'},
	{iconName: 'file', iconColor: 'text-accent-500', iconClass: 'text-4xl lg:text-6xl mb-3 lg:mb-6 pt-3 lg:pt-6 flex-shrink-0', title: '<a href="https://cdn.alexsab.ru/manuals/wey/M80-PREMIUM-RUS.pdf" target="_blank" class="inline-block pt-3 lg:pt-6">Руководство по эксплуатации WEY 80 Premium</a>'},
	{iconName: 'file', iconColor: 'text-accent-500', iconClass: 'text-4xl lg:text-6xl mb-3 lg:mb-6 pt-3 lg:pt-6 flex-shrink-0', title: '<a href="https://cdn.alexsab.ru/manuals/wey/WEY-80-BUSINESS-LOUNGЕ.pdf" target="_blank" class="inline-block pt-3 lg:pt-6">Руководство по эксплуатации WEY 80 Lounge</a>'},
];
---

<Layout title={`Программа помощи на дорогах ${brand} — круглосуточная поддержка и техническая помощь`} description={`Воспользуйтесь круглосуточной службой помощи на дорогах от ${brand}! Мы обеспечиваем поддержку, эвакуацию, транспортировку и техническую помощь в дороге. Программа для клиентов ${brand} создана для вашей безопасности и комфорта. Узнайте больше о преимуществах и условиях программы.`} image="https://cdn.alexsab.ru/pages/wey/road-assistance/banner_desktop.webp">
	<Banner banners={[banner]} />
	<section>
		<div class="container">
			<h2 class="text-center">Преимущества программы</h2>
			<div class="flex flex-wrap justify-center gap-5 lg:gap-10 text-center py-10 my-10 border-b">
				{advantages.map(item => (
					<AdvantagesItem item={item} classes="bg-gray-100 py-6 lg:py-10 px-5 flex flex-col items-center flex-grow max-w-[470px] w-full" />
				))}
			</div>
			<AdvantagesList items={advantages2} classes="grid sm:grid-cols-2 gap-5 lg:gap-10 text-center pb-10 my-10 border-b" />
			
			<h3 class="md:text-center mb-5">Программа не действует, если:</h3>

			<ul class="list-disc pl-4 space-y-2 mb-10">
				<li>Возникшие в результате противоправных действий третьих лиц / вандализма / попытки кражи автомобиля или его элементов, кроме случаев ДТП с участием автомобиля;</li>
				<li>Разбитые/поврежденные оптические приборы, перегоревшие лампочки;</li>
				<li>Все случаи блокировки автомобиля силами охраны порядка, в частности, при серьезных нарушениях;</li>
				<li>Ситуации, если неисправность автомобиля произошла, когда управление осуществляло лицо, не имеющее права на управление данным автомобилем, или лицо без водительского удостоверения;</li>
				<li>Ситуации, если неисправность автомобиля произошла, когда управление осуществляло лицо, находящееся в состоянии алкогольного или наркотического опьянения;</li>
				<li>Возгорание от внешних источников;</li>
				<li>Разбитые/поврежденные стекла, кроме ветрового стекла;</li>
				<li>Неисправности, связанные с оледенением автомобиля (невозможно открыть дверь, тронуться с места из-за примерзших тормозных колодок и пр.);</li>
				<li>Все случаи законодательно предусмотренной блокировки (например, арест имущества);</li>
				<li>Природные катастрофы и иные форс-мажорные обстоятельства (включая стихийные бедствия, политические волнения, бунты, военные действия, контртеррористические операции и их последствия (военное положение) и другие обстоятельства непреодолимой силы, которые могут повлиять на возможность оказания сервиса помощи на дороге).</li>
			</ul>

			<div class="border border-accent-500 p-3 sm:p-7 flex gap-3 sm:gap-4 items-start flex-nowrap">
				<Icon name="mdi:information" class="text-accent-500 text-2xl sm:text-3xl flex-shrink-0" />
				<div class="space-y-2 text-sm sm:text-base">
					<p>Программа не распространяется на неисправности прицепов, трейлеров, послуживших причиной обездвиживания автомобиля.</p>
					<p>Программа покрывает только случаи, связанные с неисправностями автомобилей.</p>
					<p>Программой также не покрывается организация эвакуации прицепов, трейлеров и т.п. в случае эвакуации автомобиля.</p>
					<p>Если для оказания услуг требуется проезд по платной трассе, стоимость проезда автомобиля техпомощи оплачивает Клиент.</p>
				</div>
			</div>

			<div class="grid md:grid-cols-2 xl:grid-cols-3 gap-5 lg:gap-10 mt-10">
				{advantages3.map(item => (
					<AdvantagesItem item={item} classes="bg-gray-100 py-6 lg:py-10 px-5 flex items-start gap-3 flex-nowrap" />
				))}
			</div>

		</div>
	</section>
</Layout>