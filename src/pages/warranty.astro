---
import Layout from '@/layouts/Layout.astro';
import settings from '@/data/site/settings.json';
import Banner from '@/components/Banner/Banner.astro';
import Faq from '@/components/Faq/Index.astro';
import AdvantagesItem from '@/components/Advantages/Item.astro';
import { Icon } from 'astro-icon/components';
const { brand, legal_city_where } = settings;
const banner = {
	"show": true,
	"type": "",
	"view": "link",
	"imageUrl": "https://cdn.alexsab.ru/pages/wey/warranty/banner_desktop.webp",
	"mobileImageUrl": "https://cdn.alexsab.ru/pages/wey/warranty/banner_mobile.webp",
	"title": "<nav class=\"mb-5 sm:mb-10\"><ol class=\"flex items-center flex-nowrap whitespace-nowrap gap-1 font-normal text-base\"><li class=\"!m-0 flex items-center flex-nowrap gap-1\"><a href=\"/\" class=\"!text-xs sm:!text-sm !m-0 !leading-none !no-underline font-semibold hover:opacity-80 !text-white\">Главная</a><span class=\"text-xs !leading-none\">&gt;</span></li><li class=\"!m-0 flex items-center flex-nowrap gap-1 truncate\"><span class=\"text-xs sm:text-sm !leading-none opacity-80 truncate\">Гарантия</span></li></ol></nav><h1>Гарантия WEY</h1><div class=\"mt-5\">8 лет поддержки <sup>*</sup></div>",
	"descr": "Полная уверенность в наших автомобилях, а также <br/>высокое качество производства и компонентов <br/>позволяет нам гарантировать 8 лет поддержки <br/>для вашего WEY"
};
const advantages = [
	{iconName: 'file', iconColor: 'text-accent-500', iconClass: 'text-4xl lg:text-6xl mb-3 lg:mb-6 pt-3 lg:pt-6 flex-shrink-0', title: '<a href="https://cdn.alexsab.ru/manuals/wey/manual-wey-05.pdf" target="_blank" class="inline-block pt-3 lg:pt-6">Руководство по эксплуатации WEY 05</a>'},
	{iconName: 'file', iconColor: 'text-accent-500', iconClass: 'text-4xl lg:text-6xl mb-3 lg:mb-6 pt-3 lg:pt-6 flex-shrink-0', title: '<a href="https://cdn.alexsab.ru/manuals/wey/to_WEY05.pdf" target="_blank" class="inline-block pt-3 lg:pt-6">График планового технического обслуживания WEY 05</a>'},
	{iconName: 'file', iconColor: 'text-accent-500', iconClass: 'text-4xl lg:text-6xl mb-3 lg:mb-6 pt-3 lg:pt-6 flex-shrink-0', title: '<a href="https://cdn.alexsab.ru/manuals/wey/manual-WEY-07-RUS.pdf" target="_blank" class="inline-block pt-3 lg:pt-6">Руководство по эксплуатации WEY 07</a>'},
	{iconName: 'file', iconColor: 'text-accent-500', iconClass: 'text-4xl lg:text-6xl mb-3 lg:mb-6 pt-3 lg:pt-6 flex-shrink-0', title: '<a href="https://cdn.alexsab.ru/manuals/wey/to_WEY07.pdf" target="_blank" class="inline-block pt-3 lg:pt-6">График планового технического обслуживания WEY 07</a>'},
	{iconName: 'file', iconColor: 'text-accent-500', iconClass: 'text-4xl lg:text-6xl mb-3 lg:mb-6 pt-3 lg:pt-6 flex-shrink-0', title: '<a href="https://cdn.alexsab.ru/manuals/wey/M80-PREMIUM-RUS.pdf" target="_blank" class="inline-block pt-3 lg:pt-6">Руководство по эксплуатации WEY 80 Premium</a>'},
	{iconName: 'file', iconColor: 'text-accent-500', iconClass: 'text-4xl lg:text-6xl mb-3 lg:mb-6 pt-3 lg:pt-6 flex-shrink-0', title: '<a href="https://cdn.alexsab.ru/manuals/wey/to_M80-PREMIUM.pdf" target="_blank" class="inline-block pt-3 lg:pt-6">График планового технического обслуживания WEY 80 Premium</a>'},
	{iconName: 'file', iconColor: 'text-accent-500', iconClass: 'text-4xl lg:text-6xl mb-3 lg:mb-6 pt-3 lg:pt-6 flex-shrink-0', title: '<a href="https://cdn.alexsab.ru/manuals/wey/WEY-80-BUSINESS-LOUNGЕ.pdf" target="_blank" class="inline-block pt-3 lg:pt-6">Руководство по эксплуатации WEY 80 Lounge</a>'},
	{iconName: 'file', iconColor: 'text-accent-500', iconClass: 'text-4xl lg:text-6xl mb-3 lg:mb-6 pt-3 lg:pt-6 flex-shrink-0', title: '<a href="https://cdn.alexsab.ru/manuals/wey/to_80-BUSINESS-LOUNGE-RUS.pdf" target="_blank" class="inline-block pt-3 lg:pt-6">График планового технического обслуживания WEY 80 Lounge</a>'},
];
const items = [
	{
        "id": 1,
        "question": "Гарантия на новый автомобиль (3 года или 150 000 км)",
        "answer": "Гарантия распространяется на части и компоненты каждого автомобиля, приобретенного у официального Дилера, если обнаруженная неисправность была вызвана заводским дефектом (использование некачественных материалов при производстве автомобиля или нарушением технологии производства). Гарантийный период составляет 3 года с момента передачи автомобиля WEY первому покупателю или 150 000 км пробега в зависимости от того, что наступит ранее (кроме гарантии на быстроизнашиваемые детали). Все обнаруженные или возникшие в результате эксплуатации автомобиля неисправности, подпадающие под гарантию, будут устранены официальным дилером.",
        "open": false
    },
	{
        "id": 2,
        "question": "Гарантия от сквозной коррозии (6 лет независимо от пробега)",
        "answer": "Гарантийный период против сквозной коррозии составляет 6 лет с момента передачи автомобиля WEY первому покупателю независимо от пробега. <br/><br/>Обязательным условием соблюдения гарантийных обязательств от сквозной коррозии является проведения ежегодного осмотра кузова во время посещений сервисных центров официальных дилеров.",
        "open": false
    },
	{
        "id": 3,
        "question": "Гарантия на запасные части",
        "answer": "Все новые оригинальные запасные части, установленные на автомобили или проданные покупателям без установки официальными Дилерами, обеспечиваются гарантией продолжительностью 12 месяцев (кроме быстроизнашиваемых деталей), исчисляемой cо дня их установки или со дня их продажи, без ограничения пробега.",
        "open": false
    },
	{
        "id": 4,
        "question": "Шины",
        "answer": "Гарантия на шины, первоначально установленные на новом автомобиле, предоставляется изготовителями шин.",
        "open": false
    },
];
const items2 = [
	{
        "id": 1,
        "question": "Программа постгарантийного обслуживания (5 лет или 150 000 км)",
        "answer": "Постгарантийное обслуживание вашего автомобиля WEY включает работы по ремонту и/или замене компонентов и агрегатов автомобиля (с учетом изложенных ограничений), и действует с окончания основной гарантии в течение 24 месяцев или по достижению пробега 150 000 км., а также работы по ремонту и/или замене компонентов электромобиля, таких как литиево-ионная тяговая батарея, электрический конвертер, приводной электромотор и действует с окончания основной гарантии в течение 60 месяцев или по достижению пробега 150 000 км. <br/><br/>Предоставление настоящей программы не является продлением гарантии. Воспользоваться программой сервисной поддержки вы можете у любого официального дилера.",
        "open": false
    },
];
---

<Layout title={`Гарантия ${brand} — до 8 лет уверенности и поддержки`} description={`Узнайте о гарантийной программе ${brand}: 8 лет поддержки, 6 лет защиты от коррозии и гарантия на запасные части. Высокое качество и надежность автомобилей ${brand} — полная уверенность на дороге.`} image="https://cdn.alexsab.ru/pages/wey/warranty/banner_desktop.webp">
	<Banner banners={[banner]} />

	<Faq items={items} title="Гарантия на новый автомобиль" class="bg-gray-50 !mt-0" />

	<Faq items={items2} title="Программа постгарантийного обслуживания" class="!pb-0" />

	<section>
		<div class="container">

			<div class="border border-accent-500 p-3 sm:p-7 flex gap-3 sm:gap-4 items-start flex-nowrap mb-20">
				<Icon name="mdi:information" class="text-accent-500 text-2xl sm:text-3xl flex-shrink-0" />
				<div class="space-y-2 text-sm sm:text-base">
					<p>Подробное описание гарантийного обслуживания уточняйте в электронной версии руководства по эксплуатации модели WEY</p>
				</div>
			</div>

			<h2 class="text-center">Электронное руководство по эксплуатации</h2>
			
			<div class="grid md:grid-cols-2 gap-5 lg:gap-10 my-20">
				{advantages.map(item => (
					<AdvantagesItem item={item} classes="bg-gray-100 py-6 lg:py-10 px-5 flex items-start gap-3 flex-nowrap" />
				))}
			</div>

			<small><sup>*</sup> 8 лет поддержки включают 3 года гарантии и до 5 лет программы постгарантийного обслуживания. Информация в данном разделе носит ознакомительный характер. При наличии расхождений в условиях, описанных в сервисной книжке владельца автомобиля и на данной странице, приоритет отдается сведениям, указанным в сервисной книжке. ООО «Грейт Волл Мотор Рус» оставляет за собой право внесения изменений в гарантийную политику без предварительного уведомления.</small>

		</div>
	</section>
</Layout>