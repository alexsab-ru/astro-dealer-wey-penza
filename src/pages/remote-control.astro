---

<Layout title={`Удаленное управление автомобилем через приложение`} description={`Управляйте климат-контролем, подогревом сидений и другими функциями вашего автомобиля ${brand} с телефона. Скачайте приложение для дистанционного управления и получите полный контроль над автомобилем, где бы вы ни находились!`} image="https://cdn.alexsab.ru/pages/wey/remote-control/banner_desktop.webp">
	<Banner banners={[banner]} />

    <section>
        <div class="container">
            <h2 class="text-center">Как подключить</h2>
            <AdvantagesList items={steps} classes="grid sm:grid-cols-3 gap-5 lg:gap-10 text-center mt-10" />
        </div>
    </section>

	<Faq items={items1} title="Приложение" class="border-b" />
	<Faq items={items2} title="Переход в единое приложение GWM" class="border-b" />
	<Faq items={items3} title="VPN и работа приложений" class="border-b" />
	<Faq items={items4} title="Сервисы GWM Connection" class="border-b" />
	<Faq items={items5} title="Решение проблем в приложении" class="border-b" />
	<Faq items={items6} title="Руководство по дистанционному управлению" class="border-b" />
    
    <section id="app-download">
        <div class="container">
            <h2 class="text-center">Скачать приложение</h2>
            
            <div class="flex justify-center my-10">
                <img src="https://cdn.alexsab.ru/pages/wey/remote-control/qr.svg" alt="">
            </div>

            <div class="flex justify-center gap-4 flex-wrap">
                <a target="_blank" href="https://apps.apple.com/ru/app/gwm/id1542133819">
                    <img height="44" width="252" src="https://cdn.alexsab.ru/app-buttons/app-store.svg" alt="App Store Logo">
                </a>
                <a target="_blank" href="https://play.google.com/store/apps/details?id=com.gwm.russia">
                    <img height="44" width="252" src="https://cdn.alexsab.ru/app-buttons/google-play.svg" alt="Google Play Logo">
                </a>
                <a target="_blank" href="https://appgallery.huawei.com/#/app/C104269753">
                    <img height="44" width="252" src="https://cdn.alexsab.ru/app-buttons/huawey-app.svg" alt="huawey app logo">
                </a>
            </div>

        </div>
    </section>

</Layout>