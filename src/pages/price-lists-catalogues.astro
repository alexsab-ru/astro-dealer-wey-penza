---
import PageLayout from '@/layouts/PageLayout.astro';
import settings from '@/data/settings.json';
const { brand, legal_city_where } = settings;

const links = [
	{
		id: "wey-05",
		name: "WEY 05",
		image_url: "https://cdn.alexsab.ru/pages/wey/price-lists-catalogues/05.webp",
		price_list_link: "https://cdn.alexsab.ru/pages/wey/price-lists-catalogues/price_list_wey_05.pdf",
		catalog_link: "https://cdn.alexsab.ru/pages/wey/price-lists-catalogues/brochure_wey_05.pdf",
	},
	{
		id: "wey-07",
		name: "WEY 07",
		image_url: "https://cdn.alexsab.ru/pages/wey/price-lists-catalogues/07.webp",
		price_list_link: "https://cdn.alexsab.ru/pages/wey/price-lists-catalogues/price_list_WEY_07.pdf",
		catalog_link: "https://cdn.alexsab.ru/pages/wey/price-lists-catalogues/brochure_wey_07.pdf",
	},
	{
		id: "wey-80-premium%2Cwey-80-business-lounge",
		name: "WEY 80",
		image_url: "https://cdn.alexsab.ru/pages/wey/price-lists-catalogues/80.webp",
		price_list_link: "https://cdn.alexsab.ru/pages/wey/price-lists-catalogues/price_list_wey_80.pdf",
		catalog_link: "https://cdn.alexsab.ru/pages/wey/price-lists-catalogues/brochure_wey_80.pdf",
	},
];
---

<PageLayout
    h1={`Прайс-листы и каталоги`}
    title={`Прайс-листы и каталоги ${brand}`}
	description={`Скачайте актуальные прайс-листы и фирменные брошюры на модели WEY 05, WEY 07 и WEY 80. Узнайте цены, комплектации и преимущества автомобилей WEY в ${legal_city_where}.`}
    breadcrumb={[{name:"Прайс-листы и каталоги",href:""}]}
>
	<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 sm:mt-14">
		{links.map(link => (
			<div class="flex flex-col gap-5">
				<div class="relative flex-grow">
					<img src={link.image_url} class="h-full w-full object-cover md:w-auto" alt={link.name} width="485" height="480"/>
					<h3 class="font-semibold uppercase text-white absolute bottom-4 left-6 !mb-0">{link.name}</h3>
				</div>
				<a href={link.price_list_link} class="btn btn-o w-full !m-0" target="_blank">Прайс-лист</a>
				<a href={link.catalog_link} class="btn btn-o w-full !m-0" target="_blank">Каталог</a>
				<a href={`/cars/?model=${link.id}`} class="btn w-full !m-0" target="_blank">Автомобили в наличии</a>
			</div>
		))}
	</div>
</PageLayout>