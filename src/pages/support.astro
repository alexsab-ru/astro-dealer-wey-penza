---
import Layout from '@/layouts/Layout.astro';
import Banner from '@/components/Banner/Banner.astro';
import SpecialSalonsInfo from '@/components/SpecialSalonsInfo.astro';
import settings from '@/data/site/settings.json';
import modelsData from '@/data/site/models.json';
import Faq from '@/components/Faq/Index.astro';
const { brand, legal_city_where } = settings;
const { models } = modelsData;
const modelLinks = models.filter(model => model.show).map(m => (`<a href=\"/models/${m.id}/\" class=\"underline text-accent-500 uppercase whitespace-nowrap\">${m.mark_id} ${m.name}</a>`));

const banner = {
	"show": true,
	"type": "",
	"view": "link",
	"imageUrl": "https://cdn.alexsab.ru/pages/wey/support/banner_desktop.webp",
	"mobileImageUrl": "https://cdn.alexsab.ru/pages/wey/support/banner_mobile.webp",
	"title": "<nav class=\"mb-5 sm:mb-10\"><ol class=\"flex items-center flex-nowrap whitespace-nowrap gap-1 font-normal text-base\"><li class=\"!m-0 flex items-center flex-nowrap gap-1\"><a href=\"/\" class=\"!text-xs sm:!text-sm !m-0 !leading-none !no-underline font-semibold hover:opacity-80 !text-white\">Главная</a><span class=\"text-xs !leading-none\">&gt;</span></li><li class=\"!m-0 flex items-center flex-nowrap gap-1 truncate\"><span class=\"text-xs sm:text-sm !leading-none opacity-80 truncate\">Поддержка</span></li></ol></nav><h1>Поддержка клиентов</h1><div class=\"mt-5\"><a href=\"tel:+78005550350\" class=\"underline text-xl sm:text-3xl\">8 800 555-03-50</a></div>",
};
const items1 = [
	{
        "id": 1,
        "question": "Безопасность автомобилей WEY",
        "answer": "WEY 05 получил максимальный рейтинг 5 звезд по международному стандарту Euro NCAP <sup>*</sup><br/>WEY 07 получил наивысшие оценки в серии краш-тестов по методике C-IASI <sup>**</sup><br/>WEY 80 получил максимальный рейтинг 5 звезд по стандарту China NCAP <sup>*</sup>",
        "open": false
    },
	{
        "id": 2,
        "question": "Где можно найти руководства по эксплуатации автомобилем?",
        "answer": "Ознакомиться с руководством по эксплуатации можно по <a href=\"/manuals/\" class=\"underline text-accent-500\">ссылке</a>",
        "open": false
    },
	{
        "id": 3,
        "question": "Где я могу ознакомиться со стоимостью автомобиля?",
        "answer": `Ознакомиться со стоимостью автомобиля по ссылкам <br/>(${modelLinks.join(', ')})`,
        "open": false
    },
	{
        "id": 4,
        "question": "Где я могу узнать технические характеристики автомобиля?",
        "answer": `С полными техническими характеристиками автомобиля можно ознакомиться по ссылкам <br/>(${modelLinks.join(', ')})`,
        "open": false
    }
];
const items2 = [
	{
        "id": 1,
        "question": "Какие зарядные станции подходят для использования?",
        "answer": "Type2 и CCS",
        "open": false
    },
	{
        "id": 2,
        "question": "Сколько времени требуется для зарядки автомобиля?",
        "answer": "При использовании двух разъемов (CCS/DC) время зарядки WEY 05 может составить от 53 мин. (0% - 80%) <br/><br/>При использовании двух разъемов (CCS/DC) время зарядки WEY 07 может составить от 25 мин. (0% - 80%)",
        "open": false
    },
	{
        "id": 3,
        "question": "Влияет ли климат на запас хода?",
        "answer": "Гибридный автомобиль в зимнее время года затрачивает больше энергии на обогрев салона и собственных систем, из-за чего запас хода может в некоторых случаях незначительно сократиться",
        "open": false
    },
	{
        "id": 4,
        "question": "Можно ли заряжать автомобиль от обычной розетки? // Входит ли в комплект зарядный кабель для обычных розеток?",
        "answer": "В стандартной комплектации не предусмотрено наличие кабеля для обычных розеток. В комплект входит комбинированный зарядный кабель для медленной зарядки.",
        "open": false
    },
	{
        "id": 5,
        "question": "Какой у автомобиля запас хода?",
        "answer": "Запас хода WEY 05 составляет до 918 км (по циклу NEDC). Запас хода WEY 07 составляет до 1140 км (по циклу NEDC).",
        "open": false
    },
];
const items3 = [
	{
        "id": 1,
        "question": "Какой гарантийный срок на автомобили WEY?",
        "answer": "Гарантия распространяется на части и компоненты каждого автомобиля, приобретенного у официального Дилера, если обнаруженная неисправность была вызвана заводским дефектом (использование некачественных материалов при производстве автомобиля или нарушением технологии производства). Гарантийный период составляет 3 года с момента передачи автомобиля WEY первому покупателю или 150 000 км пробега в зависимости от того, что наступит ранее (кроме гарантии на быстроизнашиваемые детали). Все обнаруженные или возникшие в результате эксплуатации автомобиля неисправности, подпадающие под гарантию, будут устранены официальным дилером. Так же, компания ООО «Грейт Волл Мотор Рус» предоставляет Владельцам Автомобилей WEY дополнительную привилегию в виде сервисной поддержки постгарантийного обслуживания Автомобиля WEY без дополнительных расходов со стороны Потребителя. Программа сервисной поддержки Постгарантийного обслуживания Автомобиля WEY включает работы по ремонту и/или замене компонентов и агрегатов автомобиля (с учетом изложенных ограничений), и действует с окончания основной гарантии в течение 24 месяцев или по достижению пробега 150 000 км., а также включает работы по ремонту и/или замене компонентов электромобиля, таких как литиево-ионная тяговая батарея, электрический конвертер, приводной электромотор, на которые  действует с окончания основной гарантии в течение 60 месяцев или по достижению пробега 150 000 км.",
        "open": false
    },
];
---

<Layout title={`Поддержка клиентов WEY – Официальная информация и часто задаваемые вопросы`} description={`Получите официальную поддержку: ответы на часто задаваемые вопросы по безопасности, сервису, гарантии, зарядке батареи и другим аспектам обслуживания автомобилей WEY. Свяжитесь с нами по бесплатному номеру 8-800-555-03-50.`} image="https://cdn.alexsab.ru/pages/wey/support/banner_desktop.webp">
	<Banner banners={[banner]} />
	<Faq items={items1} title="Общая информация" class="" />
	<Faq items={items2} title="Зарядка батареи" class="bg-gray-50" />
	<Faq items={items3} title="Сервис и гарантия" class="" />
    
    <section class="content">
        <div class="container">
            <SpecialSalonsInfo title="Задать вопрос" dataTitle="Задать вопрос" dataFormName="Задать вопрос. Поддержка клиентов WEY" />

            <small><sup>*</sup> NCAP — европейский комитет по проведению независимых краш-тестов автомобилей с оценкой активной и пассивной безопасности. Отличается применением строгих критериев оценки безопасности пассажиров и других участников дорожного движения.</small><br/>
            <small><sup>**</sup> C-IASI — это независимая оценка автомобильного индекса безопасности, разработанная китайским Институтом страховых исследований в области безопасности автомобилей. Индекс включает оценки по основным категориям: безопасность пассажиров в салоне, защита пешеходов и работа систем активной безопасности, стойкость к ударам на малой скорости. </small>

        </div>
    </section>

</Layout>